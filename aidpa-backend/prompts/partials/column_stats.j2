- `{{ col_name }}` [categorical]: cardinality={{ col.cardinality }}, nulls={{ col.null_count }} ({{ col.null_pct }}%), top=[{{ col.top_values | format_top }}]{% if col.flagged_quality %} ⚠️ HIGH NULL{% endif %}
{% endif %}
{% endfor %}
